# LLM Provider (fallback when no provider configured via dashboard)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# API Authentication (optional, leave empty to disable)
EATA_API_KEY=

# Provider ID (optional, use specific provider by ID)
PROVIDER_ID=

# Data paths (optional, override defaults)
DATABASE_PATH=./data/db.sqlite3
CHECKPOINT_PATH=./data/agent-checkpoints.sqlite3
DATA_DIR=./data
