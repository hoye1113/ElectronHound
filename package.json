{
  "_comment": "Sub-packages use @eata scope (legacy abbreviation for Electron AI Testing Agent)",
  "name": "electronhound",
  "version": "0.3.0",
  "private": true,
  "description": "AI-powered testing agent for Electron applications",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoye1113/ElectronHound.git"
  },
  "homepage": "https://github.com/hoye1113/ElectronHound",
  "bugs": {
    "url": "https://github.com/hoye1113/ElectronHound/issues"
  },
  "keywords": [
    "electron",
    "testing",
    "ai",
    "automation",
    "agent-loop",
    "mcp",
    "e2e",
    "ui-testing"
  ],
  "author": {
    "name": "hoye1113",
    "url": "https://github.com/hoye1113"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "agent:run": "npx tsx packages/agent-core/src/cli.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.29.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.29.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron"
    ]
  }
}
