{
  "name": "@eata/agent-core",
  "version": "0.1.0",
  "description": "ElectronHound agent core - Pure TypeScript agent loop implementation",
  "type": "module",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoye1113/ElectronHound.git",
    "directory": "packages/agent-core"
  },
  "keywords": ["electron", "testing", "ai", "agent", "agent-loop"],
  "author": { "name": "hoye1113" },
  "license": "MIT",
