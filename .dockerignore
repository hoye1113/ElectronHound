# =============================================================================
# Docker build context exclusions
# Reduces image build time and size by omitting unnecessary files
# =============================================================================

# Version control
.git
.gitignore

# Dependencies (rebuilt inside container)
node_modules
**/node_modules

# Build outputs (rebuilt inside container)
dist
**/dist
*.js.map
*.d.ts
*.d.ts.map

# Runtime data (not part of image)
data
.eata
*.log

# Editor / OS artifacts
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Documentation (not needed at runtime)
*.md

# Sisyphus / agent metadata
.sisyphus
.omo

# Playwright test artifacts
test-results
playwright-report
playwright/.cache
playwright-blob-storage

# Test / spec files (not needed in production image)
# Note: vitest.config.ts is NOT excluded — the Dockerfile COPY needs it
**/src/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# CI / misc
.github
.gitlab-ci.yml
.circleci

# Environment secrets (never include in image)
.env
.env.*

# Test coverage output
coverage

# Docker files (avoid recursive context)
docker-compose*.yml
Dockerfile.prod

# Misc build/IDE artifacts
.eslintcache
*.tgz
*.tar.gz
